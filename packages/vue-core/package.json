{
  "name": "@petr-ptacek/vue-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm clean",
    "build": "vite build",
    "build:types": "tsc -b ./tsconfig.types.json",
    "typecheck": "vue-tsc -b ./tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --ui --coverage",
    "clean": "rimraf ./dist ./node_modules/.tmp",
    "docs:dev": "echo 'docs not yet configured'",
    "docs:build": "echo 'docs not yet configured'",
    "docs:preview": "echo 'docs not yet configured'",
    "release:check": "echo 'not publish ready'",
    "release:dry": "echo 'not publish ready'",
    "prepublishOnly": "echo 'not publish ready'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petr-ptacek/js-lab",
    "directory": "packages/vue-ui"
  },
  "homepage": "https://github.com/petr-ptacek/js-lab",
  "files": [
    "dist"
  ],
  "types": "./dist/types/index.d.ts",
  "style": "./dist/style.css",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "default": "./dist/style.css"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@petr-ptacek/js-core": "workspace:*"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@petr-ptacek/vue-test-utils": "workspace:*",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.2.1",
    "jsdom": "^27.4.0",
    "vite": "^7.3.1",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
