{
  "name": "@petr-ptacek/js-core",
  "description": "JavaScript and TypeScript utilities.",
  "version": "1.1.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "vite build",
    "build:types": "tsc -b ./tsconfig.types.json",
    "typecheck": "tsc -b ./tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest --ui --coverage",
    "clean": "rimraf ./dist ./node_modules/.tmp",
    "docs:meta": "tsx docs/.vitepress/scripts/generateApiMetadata.ts",
    "docs:dev": "pnpm docs:meta && vitepress dev docs",
    "docs:build": "pnpm docs:meta && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:types",
    "release:dry": "pnpm release:check && npm publish --dry-run",
    "prepublishOnly": "pnpm clean && pnpm release:check"
  },
  "keywords": [
    "javascript",
    "typescript",
    "utilities",
    "math",
    "type-guards",
    "esm-only",
    "functional",
    "tree-shaking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/petr-ptacek/js-lab/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petr-ptacek/js-lab.git",
    "directory": "packages/js-core"
  },
  "homepage": "https://petr-ptacek.github.io/js-lab/js-core/",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
