{
  "extends": "../../tsconfig.app.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.snippets.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsc-snippets-out",
    "paths": {
      "@petr-ptacek/js-core": ["./src/index.ts"]
    }
  },
  "include": ["./src/**/snippets/**/*.ts"],
  "references": [{ "path": "./tsconfig.app.json" }]
}
