{
  "extends": "./../../tsconfig.app.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "isolatedDeclarations": true,
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.tmp/tsc-out"
  },
  "include": ["./src/**/*"],
  "exclude": ["**/snippets/**"]
}
